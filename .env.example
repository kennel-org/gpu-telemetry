# PostgreSQL connection (example)
PGHOST=YOUR_HOSTNAME
PGPORT=5432
PGDATABASE=telemetry
PGUSER=YOUR_DBUSER
PGPASSWORD=YOUR_DBPASSWORD
PGSSLMODE=prefer

# Logger behavior
SAMPLE_INTERVAL_SEC=5

# Remote GPU hosts to collect from via SSH (space-separated SSH targets)
# nvidia-smi is auto-detected; WSL2 hosts using /usr/lib/wsl/lib/nvidia-smi are supported
# REMOTE_HOSTS="precision3680-wsl esxi-gpu"
